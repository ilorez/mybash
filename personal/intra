# Node: this packages required in this script
# sudo pacman -S feh picom fastfetch
setup_goinfre() {

  echo "🔍 Detecting goinfre..."

  GOINFRE_PATH=$(df -h | grep goinfre | awk '{print $6}' | head -n 1)

  if [ -z "$GOINFRE_PATH" ]; then
    echo "❌ goinfre not found!"
    return 1
  fi

  export DEVROOT="$GOINFRE_PATH/$USER"
  export NVM_DIR="$DEVROOT/nvm"
  export BUN_INSTALL="$DEVROOT/bun"

  mkdir -p "$DEVROOT"/{apps,bin}
  mkdir -p "$NVM_DIR"
  mkdir -p "$BUN_INSTALL"

  export PATH="$DEVROOT/bin:$BUN_INSTALL/bin:$PATH"

  # =========================
  # NVM Setup (inside goinfre)
  # =========================
  if [ ! -f "$NVM_DIR/nvm.sh" ]; then
    echo "📦 Installing nvm..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
  fi

  export NVM_DIR="$DEVROOT/nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

  # Install latest LTS Node if missing
  if ! command -v node >/dev/null 2>&1; then
    echo "📦 Installing Node LTS..."
    nvm install --lts
    nvm use --lts
  fi

  # =========================
  # Bun Setup
  # =========================
  if [ ! -f "$BUN_INSTALL/bin/bun" ]; then
    echo "📦 Installing Bun..."
    curl -fsSL https://bun.sh/install | bash
  fi

  # =========================
  # Cursor Setup
  # =========================
  CURSOR_DIR="$DEVROOT/apps/cursor"

  if [ ! -d "$CURSOR_DIR/app" ]; then
    echo "⬇ Installing Cursor..."
    mkdir -p "$CURSOR_DIR"
    cd "$CURSOR_DIR" || return

    curl -L "https://api2.cursor.sh/updates/download/golden/linux-x64/cursor/2.5" -o cursor.AppImage
    chmod +x cursor.AppImage
    ./cursor.AppImage --appimage-extract > /dev/null 2>&1
    mv squashfs-root app
    rm cursor.AppImage
  fi

  ln -sf "$CURSOR_DIR/app/AppRun" "$DEVROOT/bin/cursor"

  # =========================
  # Desktop Entry
  # =========================
  mkdir -p ~/.local/share/applications

  cat > ~/.local/share/applications/cursor.desktop <<EOF
[Desktop Entry]
Name=Cursor
Comment=AI Code Editor
Exec=$DEVROOT/bin/cursor
Icon=$CURSOR_DIR/app/usr/share/icons/hicolor/256x256/apps/cursor.png
Terminal=false
Type=Application
Categories=Development;IDE;
StartupNotify=true
EOF

  chmod +x ~/.local/share/applications/cursor.desktop

  echo "🚀 Clean architecture ready!"
}
